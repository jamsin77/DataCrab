# DataCrab 后端环境配置（生产部署请复制为 .env 并替换所有占位值）
APP_NAME=DataCrab
APP_VERSION=1.0.0
DEBUG=False

# 注册开关：公网必须为 false，账号由管理员创建
ENABLE_REGISTRATION=false

# 管理员初始密码（可选；不填则初始化时自动生成随机强密码并打印）
# ADMIN_INITIAL_PASSWORD=

# 数据库（生产必填，使用强密码）
POSTGRES_DB=datacow
POSTGRES_USER=datacow
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://datacow:replace-with-strong-password@postgres:5432/datacow

# Redis
REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0

# JWT（生产必填，生成命令：openssl rand -hex 32）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 内部接口令牌（生产必填，生成命令：openssl rand -hex 32）
INTERNAL_API_TOKEN=

# Celery
CELERY_BROKER_URL=redis://:replace-with-strong-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-strong-password@redis:6379/2

# MinIO（生产必填）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=datacrab

# 加密密钥（生产必填；首次运行会自动生成并写入 .env）
ENCRYPT_KEY=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# CORS（生产必须写正式域名，不要用 *）
CORS_ORIGINS=["https://datacow.example.com"]

# 内部 API 地址（Docker 部署：http://backend:8000；直接部署：http://localhost:8000）
DATACRAB_API_BASE=http://backend:8000
