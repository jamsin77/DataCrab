# DataCrab 后端环境配置
APP_NAME=DataCrab
APP_VERSION=1.0.0
DEBUG=True

# 数据库（开发默认 SQLite，无需额外服务）
# 生产环境推荐 PostgreSQL：postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./datacrab.db

# JWT
JWT_SECRET_KEY=datacrab-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# LLM（启动后在前端「系统设置-大模型管理」页面填写 API Key，此处仅设默认 provider）
LLM_PROVIDER=glm

# CORS 跨域配置
# 本地开发：["http://localhost:5173","http://localhost:3000"]
# 公网部署：["*"] 放开所有来源，或指定来源如 ["http://1.2.3.4","http://example.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 内部 API 地址（技能沙箱子进程调主进程用）
# 直接部署：http://localhost:8000（默认，无需修改）
DATACRAB_API_BASE=http://localhost:8000
