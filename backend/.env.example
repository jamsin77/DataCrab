# DataCrab 后端环境配置
APP_NAME=DataCrab
APP_VERSION=1.0.0
DEBUG=True

# 数据库
DATABASE_URL=postgresql+asyncpg://datacrab:datacrab123@localhost:5432/datacrab

# JWT
JWT_SECRET_KEY=datacrab-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# CORS 跨域配置
# 本地开发：["http://localhost:5173","http://localhost:3000"]
# 公网部署：["*"] 放开所有来源，或指定来源如 ["http://1.2.3.4","http://example.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 内部 API 地址（技能沙箱子进程调主进程用）
# 直接部署：http://localhost:8000（默认，无需修改）
DATACRAB_API_BASE=http://localhost:8000
