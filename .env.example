# DataCrab 公网部署环境变量（复制为 .env 后填写）
# 生成密钥：openssl rand -hex 32

POSTGRES_DB=datacow
POSTGRES_USER=datacow
POSTGRES_PASSWORD=replace-with-strong-password

REDIS_PASSWORD=replace-with-strong-password

MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=datacrab

JWT_SECRET_KEY=
INTERNAL_API_TOKEN=
ENCRYPT_KEY=

# 必须写正式域名，不要用 *
CORS_ORIGINS=["https://datacow.example.com"]

# 管理员初始密码（可选；不填则初始化时随机生成并打印）
# ADMIN_INITIAL_PASSWORD=
