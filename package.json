{
  "name": "datacrab",
  "version": "1.0.0",
  "private": true,
  "description": "DataCrab 数据工程智能体",
  "scripts": {
    "install:frontend": "cd frontend && npm install",
    "install:backend": "pip install -e ./backend && pip install -r ./backend/requirements-optional.txt || true",
    "install": "npm run install:frontend && npm run install:backend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --reload-dir app --host 0.0.0.0 --port 8000",
    "dev": "concurrently --names \"后端,前端\" --prefix-colors \"cyan,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start": "concurrently --names \"后端,前端\" --prefix-colors \"cyan,green\" \"npm:start:backend\" \"npm:dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
